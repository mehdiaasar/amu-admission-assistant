{
  "manifest_version": 3,
  "name": "Admission Bot",
  "version": "1.0",
  "description": "AMU Admission Assistant",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "scripting",
    "storage",
    "activeTab",
    "tabs",
    "<all_urls>"
    
    ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file://*/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>",
    "http://127.0.0.1:5000/*"

  ],
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "Open Admission Bot"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }
  
}
